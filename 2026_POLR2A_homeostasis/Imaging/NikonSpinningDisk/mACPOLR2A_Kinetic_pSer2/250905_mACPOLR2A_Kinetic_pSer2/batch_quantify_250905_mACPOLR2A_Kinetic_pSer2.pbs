 --illumination_correction_file /srv/scratch/berrylab/z3536241/NikonSpinningDisk/250912_mACPOLR2A_Kinetic_pSer2/20250917_181651_148/ILLCORR/ILLCORR_20X_561_405_XXX_488.pkl

